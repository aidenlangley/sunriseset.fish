#! /usr/bin/env bash

if command -sq fish &>/dev/null; then
  echo 'Sorry, requires fish shell'
  exit 1
fi

sunrise=$(fish -c 'sunriseset sunrise')
sunset=$(fish -c 'sunriseset sunset')

path="$XDG_CONFIG_HOME"/hypr/hyprsunset.conf

old_file="$path"
new_file="$path".new

cat >"$new_file" <<EOF
# Auto generated by update-hyprsunset
profile {
  time = $sunrise
  identity = true
}

profile {
  time = $sunset
  temperature = 4500
  gamma = 0.8
}
EOF

# If diff returns true, there is no difference. When they are different, we're
# going to back up the old_file, and replace it with the new_file.
if not diff -q "$old_file" "$new_file"; then
  fish -c "backup --verbose --suffix='.bak' $old_file"
  mv -v "$new_file" "$old_file"
fi

fish -c "log --level OK 'Update complete { sunrise: $sunrise, sunset: $sunset }'"
