#! /usr/bin/env bash

if command -sq fish &>/dev/null; then
  echo 'Sorry, requires fish shell'
  exit 1
fi

sunrise=$(fish -c 'sunriseset sunrise')
sunset=$(fish -c 'sunriseset sunset')

config_path="$XDG_CONFIG_HOME"/hypr/hyprsunset.conf

old_file="$config_path"
new_file="$config_path".new

cat >"$new_file" <<EOF
# Auto generated by update-hyprsunset
profile {
  time = $sunrise
  identity = true
}

profile {
  time = $sunset
  temperature = 4500
  gamma = 0.8
}
EOF

if diff "$old_file" "$new_file" &>/dev/null; then
  # If diff returns true, there is no difference. We'll remove the new file.
  rm "$new_file"
else
  # But when they are different, we're going to back up the old_file, and
  # replace it with the new_file.
  fish -c "log --level INF 'sunrise and/or sunset has changed'"
  fish -c "backup --verbose --suffix='.bak' $old_file"
  mv -v "$new_file" "$old_file"
fi

fish -c "log --level OK 'Update complete { sunrise: $sunrise, sunset: $sunset }'"
